// Prisma schema — Vercel Postgres / Neon
// DATABASE_URL: 풀링 연결 문자열, DIRECT_URL: 마이그레이션용 비풀링 연결 문자열
// Vercel Postgres 통합을 쓰는 경우 POSTGRES_PRISMA_URL → DATABASE_URL,
// POSTGRES_URL_NON_POOLING → DIRECT_URL 로 매핑하면 됩니다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  fileName  String
  fileType  String
  fileData  Bytes // 원본 채점결과 파일 내용
  settings  Json // ExamSettings (cutoff, lowThreshold, electiveStart, selected)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
