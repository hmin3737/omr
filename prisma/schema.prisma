// Prisma schema — Vercel Prisma Postgres 통합
// 통합이 DATABASE_URL(postgres:// 형식) 하나만 주입하므로 그것만 사용한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  fileName  String
  fileType  String
  fileData  Bytes // 원본 채점결과 파일 내용
  settings  Json // ExamSettings (cutoff, lowThreshold, electiveStart, selected)
  note      String  @default("") // 시험 메모
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
