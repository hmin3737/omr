# Vercel Prisma Postgres 통합이 자동으로 주입하는 연결 문자열.
# 로컬 개발 시에는 Vercel 대시보드(Storage → 해당 DB → .env.local)에서
# 값을 복사하거나 `vercel env pull` 로 받아 아래에 채운다.

DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# 사이트 비밀번호 게이트. 미설정 시 "황제침향원" / "ghkdwpclagiddnjs" 둘 다 허용된다.
# 바꾸려면 콤마로 여러 후보를 넣을 수 있다. 예: SITE_PASSWORD="새비번,newpassword"
# SITE_PASSWORD="황제침향원,ghkdwpclagiddnjs"

# 로그인 쿠키 서명용 비밀키. 미설정 시 SITE_PASSWORD로부터 자동 도출되어 별도 설정 없이도 동작한다.
# SESSION_SECRET="충분히_긴_무작위_문자열"

# 이메일 발송(Resend, https://resend.com). 가입 후 API 키를 발급받아 넣는다.
# 도메인 인증 전에는 EMAIL_FROM을 onboarding@resend.dev 로 두면 가입한 이메일로 테스트 발송이 가능하다.
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="OMR 통계 생성기 <onboarding@resend.dev>"
