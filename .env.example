# Vercel Postgres / Neon 연결 문자열
# DATABASE_URL: 풀링(pooled) 연결 — 앱 런타임에서 사용
# DIRECT_URL:   비풀링(non-pooling) 연결 — prisma migrate/db push 에서 사용
#
# Vercel Postgres 통합을 쓰는 경우:
#   DATABASE_URL = $POSTGRES_PRISMA_URL
#   DIRECT_URL   = $POSTGRES_URL_NON_POOLING
# Neon 통합을 쓰는 경우: Neon 대시보드의 Pooled / Direct 연결 문자열을 각각 사용

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
